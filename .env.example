# Two namespaces live in this file and they are not interchangeable.
#
# [container-runtime] — handed to a container by docker-compose.yml's `environment:`
#   lists and read inside it. Most are consumed by Config, which resolves ${VAR} and
#   ${VAR:-default} inside config.json (e.g. "host": "${MQTT_HOST}"). MOTRIX_HEALTHCHECK_URL
#   is the exception: it is runtime, but it is read by the image's HEALTHCHECK rather than
#   from config.json.
#
# [compose-time] — substituted into docker-compose.yml by the docker CLI before any
#   container exists (image tags, port mappings). These never enter a container, and
#   referencing one from config.json resolves to nothing at all.
#
# `docker compose up` reads this file automatically. `python main.py` on the host does
# NOT — Config reads os.environ directly and nothing loads a dotenv file. Export it first:
#   bash:       set -a; . ./.env; set +a
#   PowerShell: Get-Content .env | % { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }

# --- MQTT [container-runtime] -------------------------------------------------
# (used when running with --profile mqtt, or connecting to an external broker)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Modbus TCP [container-runtime] ---------------------------------------------
# (used by the modbus_tcp connector; pymodbus is an optional extra — see
# requirements-modbus.txt — and is NOT installed in the default image)
#
# The meter, or the TCP gateway fronting several RS-485 slaves. Inside a container this
# must be an address the container can reach: a meter on the office LAN is not on the
# compose network, so this is a real routable IP, never "localhost".
#
# There is no authentication in Modbus TCP and no way to add any: anything that can reach
# this port can write every holding register on the device. Keep it on a segment you
# control, and do not expose the gateway to the internet.
MODBUS_HOST=
MODBUS_PORT=502
# The DEFAULT unit id. One gateway fronting several slaves addresses each by a different
# id — override those per device in listener_options.device_id rather than here. 0 is
# broadcast, 1-247 are RS-485 addresses, 255 is the Modbus-TCP "unit id not used"
# convention many native-TCP meters expect.
MODBUS_UNIT_ID=1

# --- Home Assistant [container-runtime] -----------------------------------------
# (used by the home_assistant connector; websocket-client is an optional extra — see
# requirements-homeassistant.txt — and is NOT installed in the default image)
#
# The WebSocket endpoint, so ws:// or wss:// — NOT the http:// address of the UI.
HA_URL=ws://homeassistant.local:8123/api/websocket
# A LONG-LIVED ACCESS TOKEN: Home Assistant -> your profile -> Security -> Long-lived
# access tokens. It does not expire, and it carries the FULL permissions of the user that
# created it — Home Assistant has no scoped tokens — so create a dedicated non-admin user
# for the EMS rather than minting one from your own admin account. Rotating it means
# revoking it in that same screen.
#
# The connector never logs it, and the REST API's device payload is an allowlist that
# never reaches connector attributes. It is still a plaintext credential in this file:
# keep .env out of version control.
HA_TOKEN=
# false disables BOTH certificate and hostname verification: the connection is then
# encrypted but not authenticated, so anything on the path can impersonate Home Assistant.
# Self-signed certificate on a trusted LAN only.
HA_VERIFY_SSL=true

# --- OpenEMS Edge [container-runtime] -------------------------------------------
# (used by the openems connector, which needs no extra dependency — it subclasses the
# HTTP connector and `requests` is already core)
#
# The Edge's REST controller (io.openems.edge.controller.api.rest) listens on 8084 by
# default and speaks HTTP, not HTTPS — put a TLS-terminating proxy in front and set
# "scheme": "https" in the connector options if the traffic leaves the local network.
OPENEMS_HOST=
OPENEMS_PORT=8084
# NOT a per-user secret: this is the OpenEMS user ROLE, one of guest | user | owner |
# admin, and the Edge ignores the username half of the Basic credential entirely. Treat it
# as a privilege level — `user` is enough to read every channel, `owner` and above can
# write them, and `admin` grants writes to every channel on the installation.
OPENEMS_PASSWORD=user

# --- LoRaWAN network server [container-runtime] --------------------------------
# (used by the lorawan connector, which needs no extra dependency — it subclasses the MQTT
# connector and paho is already core)
#
# The broker your network server publishes to: ChirpStack's own, or the regional Things
# Stack cluster (e.g. eu1.cloud.thethings.network).
LORAWAN_HOST=
# 1883 plain, 8883 TLS. The Things Stack Cloud requires 8883 and drops a plaintext
# connection immediately and silently — set "tls": true in the connector options with it.
LORAWAN_PORT=1883
# ChirpStack: the application UUID; leaving it empty makes the subscription use the '+'
# wildcard, which is correct for a single-application deployment. The Things Stack: required
# and of the form {app}@{tenant}, because it is BOTH the topic segment and the MQTT username
# (drop the @tenant on the open-source stack).
LORAWAN_APPLICATION_ID=
# Leave empty on The Things Stack: the connector uses LORAWAN_APPLICATION_ID and says so at
# INFO. ChirpStack authenticates with the broker's own credential.
LORAWAN_USERNAME=
# The Things Stack: an API key (NNSXS....). This is downlink authority over every actuator
# in the application — anyone holding it can close a breaker or charge a battery — and on
# ChirpStack it is also read access to every node's traffic. Never commit it.
LORAWAN_PASSWORD=
# Node identifiers used by examples/connectors/lorawan.json. Not secret: a devEUI is printed
# on the device label and appears in cleartext in every uplink topic.
LORAWAN_METER_EUI=
LORAWAN_RELAY_EUI=

# The point-to-point `lora` connector has no variables here on purpose: it needs a serial
# device on the host (/dev/ttyUSB0, COM3), which docker-compose cannot default, and pyserial
# is not in the image. Run it outside compose, or add the device mapping yourself.

# --- InfluxDB [container-runtime] ----------------------------------------------
# (used by the influxdb storage backend, and by --profile monitoring)
# INFLUXDB_URL is the in-network name; use http://localhost:8086 when running
# main.py on the host instead of in the container.
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=motrix
INFLUXDB_BUCKET=motrix
# Generate with: openssl rand -hex 32
# NOTE: the container applies this only the first time the influxdb volume is created
# (DOCKER_INFLUXDB_INIT_MODE=setup). Changing it later updates the client but not the
# server, which shows up as an unexplained 401 — run `docker compose down -v` to reset.
INFLUXDB_TOKEN=
INFLUXDB_INIT_USERNAME=motrix
INFLUXDB_INIT_PASSWORD=

# --- Grafana [container-runtime] -----------------------------------------------
# (used when running with --profile monitoring)
GRAFANA_ADMIN_PASSWORD=admin

# --- REST API service [container-runtime] ---------------------------------------
# Referenced from config.json's services entry as ${MOTRIX_API_HOST} / ${MOTRIX_API_PORT}.
# Inside a container MOTRIX_API_HOST must stay 0.0.0.0: each container has its own loopback,
# so binding 127.0.0.1 makes the API unreachable from the viewer container. "No host port
# is published" is not the same as "bind loopback" — the port is kept off the host by
# docker-compose.yml, not by the bind address. Running main.py directly on a laptop, leave
# these unset: the service then defaults to loopback, because it serves device data and
# site topology without authentication.
MOTRIX_API_HOST=0.0.0.0
MOTRIX_API_PORT=8000
# Read by the image's HEALTHCHECK, not from config.json. Leave EMPTY when config.json
# declares no rest_api service, or the container reports unhealthy forever.
MOTRIX_HEALTHCHECK_URL=http://127.0.0.1:8000/health

# --- Viewer [container-runtime] ---------------------------------------------------------
# Used only with `docker compose --profile viewer up`.
#
# nginx in the viewer container is the ONLY authentication in this system. It gates /api/* —
# live device readings, the site's device list, worker and replay state — and nothing else.
# The viewer's own HTML is public on purpose: it is the same file that project publishes as
# a release download, and it holds no data. There is no gate at all when someone opens that
# file from disk, and none is needed — the CSVs are already on their machine.
#
# Basic auth over plain HTTP sends this password base64-encoded on EVERY request. Base64 is
# encoding, not encryption: anyone who can see the traffic has the password. That is
# acceptable on the loopback bind below. It is NOT acceptable on a LAN — put TLS in front,
# or reach it over SSH or WireGuard, before you touch VIEWER_BIND.
#
# admin/admin is a placeholder, not a credential. The container logs a warning at every
# start while it is in force.
VIEWER_USER=admin
VIEWER_PASSWORD=admin
#
# on (default) | off | file
#   off  — no gate at all. The container says so loudly every time it starts. For a
#          loopback-only or tunnelled deployment where a shared password is pure friction.
#   file — use a .htpasswd bind-mounted at /etc/nginx/.htpasswd. How to have more than one
#          user, or a password that never enters this file.
# Anything that is not exactly "off" or "file" means on, including a typo: the safe
# direction for a misread variable is closed.
# VIEWER_AUTH=on

# --- Viewer [compose-time] --------------------------------------------------------------
# Substituted by the docker CLI; these never enter a container.
#
# The published image. This repository cannot verify the registry path on its own — check it
# against the viewer project's own releases before first use, and override VIEWER_IMAGE if
# it differs. VIEWER_TAG must name a tag that exists; there is deliberately no :latest.
# VIEWER_IMAGE=ghcr.io/motrix-energy/motrix-edge-view
# VIEWER_TAG=0.1.0
#
# See the VIEWER_PASSWORD note above before changing VIEWER_BIND. 0.0.0.0 puts everything
# the EMS knows about this site on the LAN behind one reversible password.
# VIEWER_BIND=127.0.0.1
# VIEWER_PORT=8080
